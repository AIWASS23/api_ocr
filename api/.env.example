# Copie para api/.env (NUNCA versione o arquivo real) e preencha.
# Gere segredos com:  ./target/release/api_ocr gen-secret
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/api_ocr   # host remoto EXIGE ?sslmode=verify-full (ou require)
# DATABASE_ALLOW_PLAINTEXT=false  # true só se o banco estiver numa rede privada isolada
BIND_ADDR=127.0.0.1:8080          # deixe em loopback; exponha só via proxy reverso com TLS
ISSUER=https://api.seudominio.com # URL pública; vira iss/aud dos tokens. https obrigatório (exceto localhost)
JWT_SECRET=                       # >= 32 caracteres, aleatório
# JWT_SECRET_PREVIOUS=            # rotação: segredo(s) antigo(s), separados por vírgula; só VALIDAM tokens
PASSWORD_PEPPER=                  # >= 32 caracteres, aleatório e DIFERENTE do JWT_SECRET
TRUST_PROXY=false                 # true só atrás de UM proxy que acrescenta o IP real em X-Forwarded-For
ALLOW_REGISTRATION=false          # cadastro público; prefira `api_ocr create-user`
# CORS_ORIGINS=https://app.seudominio.com

# Tokens
ACCESS_TOKEN_TTL_SECS=600
REFRESH_TOKEN_TTL_SECS=2592000
REFRESH_FAMILY_MAX_SECS=7776000

# OCR
OCR_MAX_UPLOAD_MB=25
OCR_MAX_PAGES=100
OCR_MAX_CONCURRENT=2
OCR_TIMEOUT_SECS=180
OCR_WORKER_MAX_RSS_MB=0           # teto de RSS por worker (o vigia mata ao passar); 0 = só o limite do contêiner
OCR_WORKER_MEMORY_MB=0            # NÃO recomendado: teto de espaço de endereçamento (o ONNX Runtime trava; veja o README)

# Limites
MAX_CONNECTIONS=1024
MAX_CONNECTIONS_PER_IP=64
MAX_IN_FLIGHT=256
RATE_GENERAL_PER_MIN=300
RATE_AUTH_PER_MIN=20
RATE_OCR_PER_MIN=10

# Pool e proteção de memória
DB_MAX_CONNECTIONS=20
OCR_MEMORY_WATERMARK_PCT=85       # recusa novo OCR (503) acima disto do limite do cgroup/host; 100 desliga

# Limite de taxa GLOBAL entre réplicas (opcional). Sem isto, cada réplica limita sozinha.
# RATE_LIMIT_REDIS_URL=redis://:senha@redis:6379     # rediss:// para TLS
# RATE_LIMIT_REDIS_PREFIX=api_ocr:

# Logs e alertas: LOG_FORMAT=json para coletores; alertas saem com target=security_alert (nível ERROR)
# LOG_FORMAT=json
SECURITY_ALERT_LOGIN_FAILURES=20  # falhas de login do mesmo IP em 5 min que disparam alerta

# Sandbox (Landlock + seccomp, na API e no worker de OCR): off | auto (padrão) | required (recusa iniciar sem ele)
SANDBOX=auto
# SANDBOX_READ_PATHS=/opt/modelos            # caminhos extras (separados por :)
# SANDBOX_RW_PATHS=/var/cache/ocr
# SANDBOX_CONNECT_PORTS=443                  # portas TCP extras de saída (ex.: VLM remoto)

# Swagger UI (/docs) e OpenAPI (/openapi.json). Desligado por padrão.
# Ao ligar, o cliente OAuth "swagger-ui" é registrado sozinho (redirect só para ISSUER/docs/oauth2-redirect.html).
ENABLE_DOCS=false
