# Copie para deploy/.env.prod (NUNCA versione). Gere segredos: api_ocr gen-secret
PUBLIC_HOST=api.seudominio.com
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=                 # >= 32 caracteres
JWT_SECRET_PREVIOUS=        # só durante a rotação do segredo (veja api/README.md)
PASSWORD_PEPPER=            # >= 32 caracteres, diferente do JWT_SECRET
ALLOW_REGISTRATION=false
# Opcionais (veja api/.env.example): OCR_MAX_UPLOAD_MB, OCR_MAX_CONCURRENT, OCR_WORKER_MEMORY_MB,
# RATE_*_PER_MIN, SECURITY_ALERT_LOGIN_FAILURES ...

# Portas publicadas pelo proxy
PROXY_BIND=0.0.0.0
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
